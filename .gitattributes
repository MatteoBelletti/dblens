# Normalize line endings in the repository; check out with the platform's native endings.
* text=auto

# Shell scripts run inside Linux containers and must keep LF everywhere.
*.sh text eol=lf
db/** text eol=lf

# Windows-only files keep CRLF.
*.ps1 text eol=crlf
*.slnx text eol=crlf

*.png binary
*.ico binary
