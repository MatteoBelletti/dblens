<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DbLens.Docs milestone M0: a throwaway spike that reads projects and endpoints from syntax only and
    prints how much resolves. Not in dblens.slnx and not shipped; M1 replaces it with DbLens.Docs.
    Run it with dotnet run on this folder, giving the path of a checkout and, optionally, an output file.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

</Project>
